# ──────────────────────────────────────────────────────────────
# Craft — environment variables
# Copy this file to .env and fill in all values.
# NEVER commit your .env file.
# ──────────────────────────────────────────────────────────────

# ── Firebase (Client SDK — safe to expose) ───────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── AI Provider (server-side only — never prefix with VITE_) ─
# Google AI Studio / Gemini API key (default provider: gemini-2.5-flash)
AI_API_KEY=

# Optional: override the model name used for summarisation and quiz generation.
# AI_MODEL=gemini-2.5-flash

# Optional: use any OpenAI-compatible endpoint (Ollama, OpenRouter, vLLM…).
# When set, AI_API_KEY is sent as the Bearer token.
# AI_BASE_URL=http://localhost:11434/v1
