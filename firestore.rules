rules_version = '2';

// Craft — Firestore security rules.
// Each signed-in user can only read and write their own data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Allows full access to all subcollections under the user's path
      // (courses, resources, attempts, chats, etc.) only to that authenticated user.
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
